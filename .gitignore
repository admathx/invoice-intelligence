# Python
__pycache__/
*.pyc
.venv/
*.egg-info/
.pytest_cache/

# Node
node_modules/
.next/
frontend/.env.local

# Playwright output (regeneratable)
frontend/test-results/
frontend/playwright-report/
frontend/blob-report/

# Env / secrets
.env
*.env.local
# Generated dev logins (backend/scripts/seed_dev_users.py)
backend/dev_users.local.json
# Real deployment settings (deploy/.env.production.example is the template)
deploy/.env.production

# Synthetic output (regeneratable, large)
synthetic/out/*
!synthetic/out/.gitkeep

# Validation results (regeneratable)
validation/results/*
!validation/results/.gitkeep

# Uploaded invoice originals
backend/uploads/
# Emails written instead of sent in development (MAIL_BACKEND=outbox)
backend/outbox/
inbox/*
!inbox/.gitkeep

# make up / make down process bookkeeping
.run/
logs/

# OS
.DS_Store
validation/test_set/
