# Copy to deploy/.env.production (never committed) and fill in.

# The public hostname; DNS must point it at this server for HTTPS to work.
DOMAIN=app.example.com
POSTGRES_PASSWORD=

# Real extraction. Without it the worker uses the fake extractor, which only
# makes sense for a test deployment.
ANTHROPIC_API_KEY=

# Invoice forwarding addresses are <location>@INBOX_DOMAIN. Its MX records
# point at your mail provider, whose inbound webhook posts to
#   https://inbound:<INBOUND_EMAIL_SECRET>@<DOMAIN>/api/inbound/email
INBOX_DOMAIN=invoices.example.com
INBOUND_EMAIL_SECRET=

# Signs unsubscribe links in emails. 32+ random characters, e.g.
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# Outgoing mail (the weekly digest, price-increase emails, password reset
# links), through your provider's SMTP relay.
# Postmark, SendGrid and Mailgun all give you these. MAIL_FROM must be an
# address your provider lets you send from.
MAIL_BACKEND=smtp
MAIL_FROM=Invoice Intelligence <digest@invoices.example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# No mail provider yet? Turn all three off instead:
# DIGESTS_ENABLED=false
# ALERT_EMAILS_ENABLED=false
# PASSWORD_RESET_ENABLED=false
# Price increases at least this big are emailed as they happen (0.10 = 10%);
# smaller ones wait for the weekly digest.
# ALERT_EMAIL_MIN_PCT_CHANGE=0.10

# Where problems are emailed: errors, invoices not being read, emails not
# sending, backups going stale. Leave empty to only log them.
OPS_EMAIL=

# Nightly database backups (the backup service): the hour they're taken, in
# UTC, and how many days are kept on the server.
# BACKUP_HOUR_UTC=7
# BACKUP_KEEP_DAYS=14

# File storage: "local" keeps files in the uploads volume on this host; "s3"
# uses a bucket (AWS S3, Cloudflare R2, MinIO). Needed if the API and worker
# ever run on separate machines.
STORAGE_BACKEND=local
S3_BUCKET=
S3_PREFIX=
S3_ENDPOINT_URL=
S3_REGION=
# With STORAGE_BACKEND=s3 and no instance role:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
