# Where the Next.js server reaches the API. The browser never uses this: it
# goes through the /api proxy on this origin (next.config.js).
API_BASE=http://localhost:8000
# The location the Playwright suite runs its fixtures in (e2e/dashboard.spec.ts).
# It signs in as its own throwaway member of this location. Any tenant id works;
# `make smoke` prints one.
E2E_TENANT_ID=
